# Copie este arquivo para .env e preencha com os valores reais
# O arquivo .env nunca deve ser commitado no git

DB_USER=userjcfcontrolapp
DB_PASSWORD=
DB_NAME=db_jcf_quinze_dev

# Chave de assinatura dos tokens JWT — gere uma string aleatória com pelo menos 32 caracteres
# (ex.: openssl rand -base64 48)
JWT_SECRET=

# Bootstrap do primeiro usuário Admin (criado automaticamente no startup da API se ainda não existir)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULLNAME=
ADMIN_PHONE=
